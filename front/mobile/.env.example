# PC's LAN IP — update each session before running.
# Windows: ipconfig → "IPv4 Address" under your Wi-Fi adapter.
EXPO_PUBLIC_LAN_IP=YOUR_LAN_IP

# MapTiler API key (free tier: 100k tiles/month).
# Sign up at https://cloud.maptiler.com/ and paste your key here.
EXPO_PUBLIC_MAPTILER_KEY=YOUR_MAPTILER_KEY
